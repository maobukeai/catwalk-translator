{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatwalkTranslator",
  "version": "0.0.1",
  "identifier": "com.maobukeai.catwalk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 截图与划词翻译器",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 580,
        "center": true,
        "focus": true,
        "visible": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "assets/dicts": "assets/dicts",
      "assets/offline/general_ui_dict.json": "assets/offline/general_ui_dict.json"
    }
  }
}
